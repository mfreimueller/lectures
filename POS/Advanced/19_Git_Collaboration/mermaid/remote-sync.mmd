flowchart LR
    subgraph Lokal[Lokal]
        direction LR
        LM[main] --- LD[dev] --- LF[feature]
    end
    subgraph Remote[Remote origin]
        direction LR
        RM[main] --- RD[dev]
    end
    Lokal <-->|push / pull| Remote

    classDef lokalStyle fill:#E8F0FA,stroke:#004A8D,stroke-width:2px
    classDef remoteStyle fill:#FDE8ED,stroke:#ED1944,stroke-width:2px
    class Lokal lokalStyle
    class Remote remoteStyle
